# Set these in Vercel → Project → Settings → Environment Variables.
# They are Illusory's own client credentials and stay server-side: the Mac app
# never sees them, which is the whole reason this site exists.

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only needed if the site is not on https://illusory.fulmina.re
# ILLUSORY_SITE=
