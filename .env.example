# ── Model access ──────────────────────────────────────────────────────────────
# Illusory routes inference through OpenRouter so the intent model can be swapped
# without a rebuild. Keep it fast — the whole gesture has a one-second budget.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Integrations (Phase 2) ────────────────────────────────────────────────────
# These authorise Illusory against YOUR workspaces, and are only read when you
# connect a service. Illusory itself has no account and no sign-in: there is no
# OAuth to use the app. Nothing here is required for the core gesture to work.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token Illusory actually calls the API with (xoxp- preferred, acts as you).
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=

# OAuth pair — only needed when other people install Illusory.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
