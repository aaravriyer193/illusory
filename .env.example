# Illusory — the Mac app's own configuration.
#
# Copy to .env in this same directory. Only these four keys are read by the app;
# everything else it needs lives on the website (see web/README.md), because a
# distributed .app cannot keep a secret.

# ── Model ─────────────────────────────────────────────────────────────────────
# Required unless you run Illusory on Ollama. The hosted model itself is pinned
# in the app: it has to be fast, vision-capable and non-reasoning, so it is not
# a setting.
OPENROUTER_API_KEY=

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Only read when the provider is set to Ollama in Settings. Both have sensible
# defaults, so leave them blank unless yours differ.
OLLAMA_HOST=
OLLAMA_MODEL=

# ── Website (optional) ────────────────────────────────────────────────────────
# Where the Connect buttons send people. Defaults to https://illusory.fulmina.re;
# set this only when testing against a preview deployment or localhost.
ILLUSORY_SITE=
